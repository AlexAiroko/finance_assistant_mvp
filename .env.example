APP_NAME=Finance Assistant API
APP_ENV=development
DEBUG=false

# Для локального запуска: localhost.
# Для Docker: игнорируется — docker-compose.yml переопределяет на "db".
DB_HOST=localhost
DB_PORT=5432
DB_USER=finance_user
DB_PASS=change_me
DB_NAME=finance_assistant

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=

CORS_ORIGINS=http://localhost:3000
